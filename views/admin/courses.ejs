<!-- Page Title -->
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <h1>Manage Courses</h1>
      <p>View, edit, and delete courses.</p>
    </div>
  </div>
</div>

<section class="section">
  <div class="container">

    <div class="text-end mb-3">
      <a href="/admin/create-course" class="btn btn-primary">+ Create New Course</a>
    </div>

    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th>Image</th>
          <th>Title</th>
          <th>Trainer</th>
          <th>Price</th>
          <th>Seats</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% courses.forEach(course => { %>
        <tr>
          <td>
            <img src="<%= course.image %>" style="width:80px; border-radius:6px;">
          </td>

          <td><%= course.title %></td>

          <td><%= course.trainer?.name || "N/A" %></td>

          <td>$<%= course.price %></td>

          <td>
            <%= course.registrants.length %> /
            <%= course.capacity %>
          </td>

          <td>
            <a href="/admin/courses/<%= course._id %>/edit" class="btn btn-warning btn-sm">Edit</a>

            <form
              action="/admin/courses/<%= course._id %>/delete"
              method="post"
              style="display:inline;"
              onsubmit="return confirm('Are you sure you want to delete this course?')"
            >
              <button class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>

    </table>
  </div>
</section>
