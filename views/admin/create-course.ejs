<!-- Page Title -->
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <div class="row d-flex justify-content-center text-center">
        <div class="col-lg-8">
          <h1>Create New Course</h1>
          <p class="mb-0">
            Fill out the details below to add a new course to the Mentor platform.
          </p>
        </div>
      </div>
    </div>
  </div>

  <nav class="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/courses">Courses</a></li>
        <li class="current">Create Course</li>
      </ol>
    </div>
  </nav>
</div>
<!-- End Page Title -->

<section id="contact" class="contact section">
  <div class="container" data-aos="fade-up" data-aos-delay="100">

    <div class="row gy-4 justify-content-center">
      <div class="col-lg-10">

        <!-- FORM START -->
        <form
          action="/admin/create-course"
          method="post"
          enctype="multipart/form-data"
          class="php-email-form"
        >
          <div class="row gy-4">

            <!-- TITLE -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Course Title</label>
              <input type="text" class="form-control" name="title" required />
            </div>

            <!-- SUMMARY -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Summary</label>
              <input type="text" class="form-control" name="summary" required />
            </div>

            <!-- DESCRIPTION -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Description</label>
              <textarea
                class="form-control"
                name="description"
                rows="5"
                required
              ></textarea>
            </div>

            <!-- PRICE & CAPACITY -->
            <div class="col-md-6">
              <label class="form-label fw-bold">Price ($)</label>
              <input type="number" step="0.01" name="price" class="form-control" required />
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold">Capacity</label>
              <input type="number" name="capacity" class="form-control" required />
            </div>

            <!-- TRAINER DROPDOWN -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Trainer</label>
              <select class="form-control" name="trainer" required>
                <% trainers.forEach(t => { %>
                  <option value="<%= t._id %>"><%= t.name %></option>

                <% }) %>
              </select>
            </div>

            <!-- SCHEDULE -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Schedule (Day/Time)</label>
              <input
                type="text"
                class="form-control"
                name="schedule"
                placeholder="e.g. Mondays 6–8 PM"
                required
              />
            </div>

            <!-- IMAGE UPLOAD -->
            <div class="col-md-12">
              <label class="form-label fw-bold">Course Image</label>
              <input
                type="file"
                name="image"
                class="form-control"
                accept=".jpg,.jpeg,.png"
                required
              />
            </div>

            <!-- SUBMIT BUTTON -->
            <div class="col-md-12 text-center">
              <button type="submit" class="btn btn-primary px-4 py-2 mt-3">
                Create Course
              </button>
            </div>

          </div>
        </form>
        <!-- END FORM -->

      </div>
    </div>

  </div>
</section>
